<resources>
    <!--
      Base theme applied before Compose takes over. It only needs to get the launch
      window right: matching the app background here is what stops the white flash
      between the launcher icon and the first frame of Compose.
    -->
    <style name="Theme.PotheRide" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
